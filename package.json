{
	"name": "pi-config",
	"version": "0.1.0",
	"private": true,
	"description": "Personal Pi monorepo",
	"license": "UNLICENSED",
	"type": "module",
	"workspaces": [
		"extensions/*"
	],
	"scripts": {
		"check": "npm run biome && npm run typecheck && npm run test && npm run structure",
		"biome": "biome check extensions scripts themes package.json tsconfig.json biome.json",
		"biome:fix": "biome check --write extensions scripts themes package.json tsconfig.json biome.json",
		"typecheck": "tsc --noEmit",
		"test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test extensions/**/*.test.ts",
		"structure": "node scripts/check.ts"
	},
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./extensions/github-copilot-auto/index.ts",
			"./extensions/question/index.ts",
			"./extensions/pi-goal/index.ts",
			"./extensions/pi-web-access/index.ts",
			"./extensions/pi-anthropic-oauth/index.ts",
			"./extensions/pi-lsp/index.ts",
			"./extensions/pi-openrouter-metadata/index.ts",
			"./extensions/pi-setup-custom-providers/index.ts",
			"./extensions/pi-sensitive-guard/index.ts",
			"./extensions/pi-antigravity-auth/index.ts",
			"./extensions/pi-background-tasks/index.ts",
			"./extensions/pi-clinepass-provider/index.ts",
			"./extensions/pi-direnv/index.ts",
			"./extensions/pi-subagents/index.ts",
			"./extensions/pi-service-tier/index.ts",
			"./extensions/pi-usage/index.ts"
		],
		"themes": [
			"./themes/flatland.json"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@earendil-works/pi-ai": "0.83.0",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@earendil-works/pi-tui": "0.83.0",
		"@types/node": "26.1.2",
		"typescript": "7.0.2",
		"typebox": "1.3.9"
	},
	"overrides": {
		"minimatch": "10.2.6"
	}
}
