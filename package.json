{
	"name": "pi-config",
	"version": "0.1.0",
	"private": true,
	"description": "Personal Pi monorepo",
	"license": "UNLICENSED",
	"type": "module",
	"workspaces": [
		"extensions/*"
	],
	"scripts": {
		"check": "npm run biome && npm run typecheck && npm run test && npm run structure",
		"biome": "biome check extensions scripts package.json tsconfig.json biome.json",
		"biome:fix": "biome check --write extensions scripts package.json tsconfig.json biome.json",
		"typecheck": "tsc --noEmit",
		"test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test extensions/**/*.test.ts",
		"structure": "node scripts/check.ts"
	},
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./extensions/pi-github-copilot/index.ts",
			"./extensions/pi-question/index.ts",
			"./extensions/pi-goal/index.ts",
			"./extensions/pi-gpt-search/index.ts",
			"./extensions/pi-anthropic-oauth/index.ts",
			"./extensions/pi-lsp/index.ts",
			"./extensions/pi-nix-store-guard/index.ts",
			"./extensions/pi-openrouter-metadata/index.ts",
			"./extensions/pi-setup-custom-providers/index.ts",
			"./extensions/pi-sensitive-guard/index.ts",
			"./extensions/pi-antigravity-auth/index.ts",
			"./extensions/pi-background-tasks/index.ts",
			"./extensions/pi-compaction/index.ts",
			"./extensions/pi-direnv/index.ts",
			"./extensions/pi-subagents/index.ts",
			"./extensions/pi-service-tier/index.ts",
			"./extensions/pi-usage/index.ts",
			"./extensions/pi-better-edit/index.ts",
			"./extensions/pi-fff/src/index.ts"
		],
		"prompts": [
			"./prompts"
		],
		"themes": [
			"./extensions/pi-themes/themes"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@earendil-works/pi-ai": "^0.84.3",
		"@earendil-works/pi-coding-agent": "^0.84.3",
		"@earendil-works/pi-tui": "^0.84.3",
		"@sinclair/typebox": "^0.34.52",
		"@types/node": "^26.4.0",
		"bun-types": "^1.4.0",
		"typebox": "^1.3.19",
		"typescript": "7.0.2"
	},
	"overrides": {
		"minimatch": "10.2.6"
	}
}
