{
	"name": "pi-config",
	"version": "0.1.0",
	"private": true,
	"description": "Personal Pi monorepo",
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run structure",
		"lint": "biome lint extensions scripts themes package.json tsconfig.json biome.json",
		"format": "biome format --write extensions scripts themes package.json tsconfig.json biome.json",
		"format:check": "biome format extensions scripts themes package.json tsconfig.json biome.json",
		"typecheck": "tsc --noEmit",
		"test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test extensions/**/*.test.ts",
		"structure": "node scripts/check.ts"
	},
	"dependencies": {
		"@cortexkit/antigravity-auth-core": "2.0.0",
		"@mozilla/readability": "0.6.0",
		"@sinclair/typebox": "^0.34.52",
		"linkedom": "0.16.11",
		"turndown": "7.2.4",
		"typebox": "1.3.8",
		"unpdf": "1.6.2"
	},
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./extensions/github-copilot-auto/index.ts",
			"./extensions/question/index.ts",
			"./extensions/pi-goal/index.ts",
			"./extensions/pi-web-access/index.ts",
			"./extensions/pi-anthropic-oauth/index.ts",
			"./extensions/pi-lsp/index.ts",
			"./extensions/pi-openrouter-metadata/index.ts",
			"./extensions/pi-setup-custom-providers/index.ts",
			"./extensions/pi-sensitive-guard/index.ts",
			"./extensions/pi-antigravity-auth/index.ts",
			"./extensions/pi-background-tasks/index.ts",
			"./extensions/pi-direnv/index.ts",
			"./extensions/pi-subagents/index.ts"
		],
		"themes": [
			"./themes/flatland.json"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@earendil-works/pi-ai": "0.82.1",
		"@earendil-works/pi-coding-agent": "0.82.1",
		"@earendil-works/pi-tui": "0.82.1",
		"@types/node": "24.13.3",
		"@types/turndown": "5.0.6",
		"typescript": "5.9.3"
	}
}
